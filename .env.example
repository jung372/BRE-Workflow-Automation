# MetMast(Ammonit) 계측기 접속 정보
# ID/PW 가 비어 있으면 해당 계측기는 조용히 Offline 으로 보고되어
# Teams 알림이 매일 오탐을 냅니다. 실제 값을 반드시 입력하세요.
METMAST_SIRU_URL=
METMAST_SIRU_ID=
METMAST_SIRU_PW=
METMAST_GOGK_URL=
METMAST_GOGK_ID=
METMAST_GOGK_PW=
METMAST_BLMU_URL=
METMAST_BLMU_ID=
METMAST_BLMU_PW=
METMAST_DKAM_URL=
METMAST_DKAM_ID=
METMAST_DKAM_PW=

# 해외 IP 를 지오-차단하는 .go.kr / .re.kr 사이트 우회용 한국 리전 프록시.
# 서버 PC(국내망)는 비워 둡니다. 사내망에서 개발할 때만 설정하세요.
HTTP_PROXY_KR=

# page.goto 네비게이션 타임아웃(ms). 프록시 지연이 크면 상향 조정.
GOTO_TIMEOUT_MS=40000

# --- 아래는 서버 예약 작업(launcher\run_scrape.ps1)이 설정합니다. -------
# 개발 PC 에서는 설정하지 마세요. 미설정 시 저장소 루트로 폴백되어
# 기존과 동일하게 동작합니다.
#
#   BRE_DATA_DIR     last_state.json / data\status.json 위치 (서버: publish clone)
#   BRE_RUNTIME_DIR  로그·락·배포 메타 위치
#   BRE_ENV_FILE     이 파일의 경로
#   BRE_NODE_ROLE    server
#   BRE_SKIP_PUSH    1 이면 발행(commit & push) 생략
#   BRE_SMOKE_MIN_OK 스모크 통과에 필요한 최소 수집 성공 사이트 수 (기본 3)

# Teams 웹훅은 GitHub Actions(report.yml)에서 발송하므로
# GitHub Secret TEAMS_WEBHOOK_URL 에 두고 이 파일에는 넣지 않습니다.
